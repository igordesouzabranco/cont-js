<% if (errors.length > 0) { %>
    <div class="mb-3">
        <% errors.forEach(error => { %>
            <div class="alert alert-danger"><%= error %></div>
        <% }); %>
    </div>
<% } %>

<% if (success.length > 0) { %>
    <div class="mb-3">
        <% success.forEach(message => { %>
            <div class="alert alert-success"><%= message %></div>
        <% }); %>
    </div>
<% } %>
