<% if (errors.length > 0) { %>
    <div class="row">
        <% errors.forEach(error => { %>
            <div class="col my-2">
                <div class="alert alert-danger"><%= error %></div>
            </div>
        <% }); %>
    </div>
<% } %>

<% if (success.length > 0) { %>
    <div class="row">
        <% success.forEach(message => { %>
            <div class="col my-2">
                <div class="alert alert-success"><%= message %></div>
            </div>
        <% }); %>
    </div>
<% } %>
    