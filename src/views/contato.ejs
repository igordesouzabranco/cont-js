<%- include('includes/head') -%>
<%- include('includes/navbar') -%>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="my-5">
                    <h1 class="text-center mb-2"><%= contato._id ? 'Editar Contato' : 'Novo Contato' %></h1>
                    <p class="text-center lead mb-4"><%= contato._id ? 'Atualize as informações do contato.' : 'Preencha os dados para adicionar.' %></p>

                    <%- include('includes/messages') -%>

                    <% if (contato._id) { %>
                        <form action="/contato/update/<%= contato._id %>" method="POST" class="js-contato-form" novalidate>
                    <% } else { %>
                        <form action="/contato/register" method="POST" class="js-contato-form" novalidate>
                    <% } %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="form-group">
                                <label class="form-label">Nome *</label>
                                <input value="<%= contato && contato.nome ? contato.nome : '' %>" type="text" class="form-control" name="nome" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Apelido</label>
                                <input value="<%= contato && contato.nickname ? contato.nickname : '' %>" type="text" class="form-control" name="nickname">
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Telefone</label>
                                        <input value="<%= contato && contato.phone ? contato.phone : '' %>" type="text" class="form-control" name="phone">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Email</label>
                                        <input value="<%= contato && contato.email ? contato.email : '' %>" type="email" class="form-control" name="email">
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mt-4">
                                <button type="submit" class="btn btn-primary">
                                    <%= contato._id ? 'Salvar' : 'Cadastrar' %>
                                </button>
                                <a href="/" class="btn btn-secondary">Cancelar</a>
                            </div>
                        </form>
                </div>
            </div>
        </div>
    </div>
<%- include('includes/footer') -%>
