<%- include('includes/head') -%>
    <%- include('includes/navbar') -%>
        <div class="container">
            <div class="row">
                <div class="col-md-2"></div>
                <div class="col-md-8 my-5">
                    <h1 class="text-center">Cadastrar Contatos</h1>
                    <p class="text-center lead">Cadastre ou edite seus contatos na AgendaJS.</p>

                    <%- include('includes/messages') -%>

                    <% if (contato._id) {%>
                        <form action="/contato/update/<%= contato._id %>" method="POST" class="js-contato-form" novalidate>

                    <% } else { %>
                        <form action="/contato/register" method="POST" class="js-contato-form" novalidate>
                    <% } %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="mb-3">
                                <label for="nome" class="form-label">Digite o nome do contato</label>
                                <input value="<%= contato && contato.nome ? contato.nome : '' %>" type="text" class="form-control" name="nome" required>
                            </div>
                            <div class="mb-3">
                                <label for="nickname" class="form-label">Digite o apelido do contato</label>
                                <input value="<%= contato && contato.nickname ? contato.nickname : '' %>" type="text" class="form-control" name="nickname">
                            </div>
                            <div class="mb-3">
                                <label for="phone" class="form-label">Digite o telefone do contato</label>
                                <input value="<%= contato && contato.phone ? contato.phone : '' %>" type="text" class="form-control" name="phone">
                            </div>
                            <div class="mb-3">
                                <label for="email" class="form-label">Digite o email do contato</label>
                                <input value="<%= contato && contato.email ? contato.email : '' %>" type="email" class="form-control" name="email">
                            </div>
                            <button type="submit" class="btn btn-primary">Cadastrar</button>
                        </form>




                </div>
                <div class="col-md-2"></div>
            </div>
        </div>
        <%- include('includes/footer') -%>
